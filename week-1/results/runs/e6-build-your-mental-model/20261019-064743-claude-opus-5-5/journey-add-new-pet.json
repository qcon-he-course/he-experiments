  "cards": [
    {
      "dot": "orange",
      "title": "No access control",
      "items": [
        "No Spring Security dependency in pom.xml",
        "Any anonymous visitor can add a pet to any owner id"
      ]
    },
    {
      "dot": "cyan",
      "title": "No Pet repository",
      "items": [
        "The pet is saved through the Owner aggregate",
        "JPA cascade on Owner.pets writes the pets row"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dashed = inferred",
      "items": [
        "Framework wiring (binder, formatter, @Valid) and Hibernate-generated SQL",
        "Not confirmed by a runtime trace"
      ]
    }
